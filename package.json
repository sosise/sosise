{
  "name": "sosise",
  "version": "2.0.1",
  "description": "Sosise is a web application boilerplate/framework with an expressive, elegant syntax. A Sosise provides a structure and starting point for creating your application, allowing you to focus on creating something amazing while we sweat the details.",
  "main": "server.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/sosise/sosise"
  },
  "scripts": {
    "dev": "nodemon",
    "watch": "nodemon",
    "build": "npm run clean:docs && npm run clean:migrations && npm run copy-docs && tsc",
    "start": "node build/server.js",
    "clean:docs": "rm -rf docs/src/Types docs/src/Unifiers docs/src/Enums",
    "clean:migrations": "rm -rf build/database/migrations",
    "copy-docs": "cp -R src/app/Types src/app/Unifiers src/app/Enums docs/src/.",
    "test": "jest -c ./build/config/jest.js --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "update-sosise": "npm install sosise-core@latest"
  },
  "author": "Igor Kov",
  "license": "MIT",
  "dependencies": {
    "bullmq": "^5.71.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "knex": "^3.1.0",
    "sosise-core": "^2.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.3.0",
    "@types/express": "^5.0.2",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.21",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^17.8.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.33.1"
  }
}
